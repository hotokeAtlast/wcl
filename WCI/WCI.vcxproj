  <!--
    The shader is compiled at RUNTIME by D3DCompileFromFile (see Renderer.cpp).
    We include the .hlsl here so VS provides IntelliSense / syntax highlighting
    but set ExcludedFromBuild=true so MSBuild does NOT invoke FXC offline.
    If you prefer an offline-compiled .cso, remove ExcludedFromBuild and set
    ShaderType, ShaderModel, EntryPointName accordingly.
  -->
  <ItemGroup>
    <None Include="InvertShader.hlsl">
      <FileType>Document</FileType>
    </None>
    <None Include="packages.config" />
  </ItemGroup>
  <!-- â”€â”€â”€ Resources â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
